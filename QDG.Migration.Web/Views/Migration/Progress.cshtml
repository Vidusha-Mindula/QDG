@{
    ViewData["Title"] = "Migration Progress";
    var sessionId = ViewBag.SessionId;
}

<div class="card">
    <div class="card-header">
        <h2>Migration in Progress</h2>
    </div>
    <div class="card-body">
        <div class="mb-4">
            <h5>Overall Progress</h5>
            <div class="progress mb-2" style="height: 30px;">
                <div id="overallProgress" class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" style="width: 0%">0%</div>
            </div>
            <div class="row text-center">
                <div class="col">
                    <strong id="completedTables">0</strong> / <strong id="totalTables">0</strong> Tables
                </div>
                <div class="col">
                    <strong>Elapsed:</strong> <span id="elapsed">00:00:00</span>
                </div>
            </div>
        </div>

        <div class="mb-4" id="currentTableSection" style="display: none;">
            <h5>Current Table: <span id="currentTable"></span></h5>
            <div class="progress mb-2" style="height: 25px;">
                <div id="tableProgress" class="progress-bar" role="progressbar" style="width: 0%">0%</div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title">Rows Copied</h6>
                        <h3 id="rowsCopied">0</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title">Errors</h6>
                        <h3 id="errorCount" class="text-danger">0</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title">Status</h6>
                        <h3 id="status">Running</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-light">
                    <div class="card-body text-center">
                        <h6 class="card-title">Speed</h6>
                        <h3 id="speed">-</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Table-by-Table Progress</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm table-hover" id="tableProgressTable">
                        <thead class="table-light">
                            <tr>
                                <th>Table Name</th>
                                <th style="width: 120px;">Status</th>
                                <th style="width: 200px;">Progress</th>
                                <th>Rows</th>
                                <th>Errors</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="5" class="text-center text-muted">Waiting for data...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5>Activity Log</h5>
            </div>
            <div class="card-body">
                <div id="activityLog" style="max-height: 300px; overflow-y: auto; font-family: monospace; font-size: 12px;">
                    <p class="text-muted">Waiting for updates...</p>
                </div>
            </div>
        </div>

        <div class="mt-4" id="completionButtons" style="display: none;">
            <a asp-action="Results" asp-route-sessionId="@sessionId" class="btn btn-success">
                View Results <i class="bi bi-arrow-right"></i>
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/migration-progress.js" asp-append-version="true"></script>
    <script>
        const sessionId = '@sessionId';
        const progressTracker = new MigrationProgressTracker(sessionId);
        progressTracker.start();
    </script>
}
