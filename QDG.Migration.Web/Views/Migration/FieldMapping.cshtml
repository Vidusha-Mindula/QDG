@model QDG_DB_Migrator.Models.FieldMappingViewModel
@{
    ViewData["Title"] = "Field Mapping";
}

<div class="card">
    <div class="card-header">
        <h2>Field Mapping Configuration</h2>
    </div>
    <div class="card-body">
        <div class="alert alert-info">
            <strong><i class="bi bi-info-circle"></i> Instructions:</strong>
            Configure custom column name mappings for your migration. Source columns (read-only) will be mapped
            to destination columns (editable). Leave destination names unchanged for default one-to-one mapping.
        </div>

        <form asp-action="FieldMappingPost" method="post" id="fieldMappingForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sessionId" value="@Model.SessionId" />

            <div class="accordion" id="tableMappingsAccordion">
                @for (int i = 0; i < Model.TableMappings.Count; i++)
                {
                    var table = Model.TableMappings[i];
                    var collapseId = $"collapse{i}";
                    var headingId = $"heading{i}";

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button @(i > 0 ? "collapsed" : "")" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="@(i == 0 ? "true" : "false")" aria-controls="@collapseId">
                                <i class="bi bi-table me-2"></i>
                                <strong>@table.TableName</strong>
                                <span class="badge bg-secondary ms-2">@table.ColumnMappings.Count columns</span>
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse @(i == 0 ? "show" : "")"
                             aria-labelledby="@headingId" data-bs-parent="#tableMappingsAccordion">
                            <div class="accordion-body">
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th style="width: 5%;">#</th>
                                                <th style="width: 25%;">Source Column</th>
                                                <th style="width: 25%;">Destination Column</th>
                                                <th style="width: 15%;">Data Type</th>
                                                <th style="width: 10%;">Nullable</th>
                                                <th style="width: 10%;">Primary Key</th>
                                                <th style="width: 10%;">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int j = 0; j < table.ColumnMappings.Count; j++)
                                            {
                                                var column = table.ColumnMappings[j];
                                                var index = i * 1000 + j;

                                                <tr>
                                                    <td>@(j + 1)</td>
                                                    <td>
                                                        <strong>@column.SourceColumn</strong>
                                                        @if (column.IsPrimaryKey)
                                                        {
                                                            <span class="badge bg-primary ms-1" title="Primary Key">PK</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <input type="hidden" name="mappings[@index].TableName" value="@table.TableName" />
                                                        <input type="hidden" name="mappings[@index].SourceColumn" value="@column.SourceColumn" />
                                                        <input type="text"
                                                               name="mappings[@index].DestinationColumn"
                                                               value="@column.DestinationColumn"
                                                               class="form-control form-control-sm"
                                                               placeholder="@column.SourceColumn"
                                                               pattern="[a-zA-Z_][a-zA-Z0-9_]*"
                                                               title="Column name must start with letter or underscore, followed by letters, numbers, or underscores" />
                                                    </td>
                                                    <td>
                                                        <code class="text-muted">@column.DataType</code>
                                                    </td>
                                                    <td>
                                                        @if (column.IsNullable)
                                                        {
                                                            <span class="badge bg-success">Yes</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">No</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (column.IsPrimaryKey)
                                                        {
                                                            <i class="bi bi-check-circle-fill text-success"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-dash-circle text-muted"></i>
                                                        }
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-secondary reset-btn"
                                                                data-original="@column.SourceColumn"
                                                                data-target="mappings[@index].DestinationColumn"
                                                                title="Reset to source name">
                                                            <i class="bi bi-arrow-counterclockwise"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-secondary bulk-reset-btn" data-table="@table.TableName">
                                        <i class="bi bi-arrow-counterclockwise"></i> Reset All Columns in This Table
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a asp-action="RelationshipConfig" asp-route-sessionId="@Model.SessionId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                <div>
                    <button type="button" class="btn btn-warning me-2" id="resetAllBtn">
                        <i class="bi bi-arrow-counterclockwise"></i> Reset All Mappings
                    </button>
                    <button type="submit" class="btn btn-success">
                        Next <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </form>

        <div class="mt-4">
            <div class="card bg-light">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-lightbulb"></i> Mapping Tips</h5>
                    <ul class="mb-0">
                        <li>Column names must start with a letter or underscore</li>
                        <li>Only letters, numbers, and underscores are allowed</li>
                        <li>Leave destination column blank or unchanged for default one-to-one mapping</li>
                        <li>Primary key columns should typically maintain their names for relationships</li>
                        <li>Use the reset buttons to revert changes for individual columns or entire tables</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.reset-btn').click(function() {
                const originalName = $(this).data('original');
                const targetName = $(this).data('target');
                $(`input[name="${targetName}"]`).val(originalName);
                showNotification('Column reset to original name', 'info');
            });

            $('.bulk-reset-btn').click(function() {
                const tableName = $(this).data('table');
                const accordionBody = $(this).closest('.accordion-body');

                accordionBody.find('input[type="text"]').each(function() {
                    const hiddenInput = $(this).prev().prev();
                    const sourceColumn = hiddenInput.val();
                    $(this).val(sourceColumn);
                });

                showNotification(`All columns in ${tableName} reset to original names`, 'success');
            });

            $('#resetAllBtn').click(function() {
                if (confirm('Are you sure you want to reset ALL column mappings to their original names?')) {
                    $('input[type="text"][name*="DestinationColumn"]').each(function() {
                        const hiddenInput = $(this).prev().prev();
                        const sourceColumn = hiddenInput.val();
                        $(this).val(sourceColumn);
                    });
                    showNotification('All column mappings have been reset', 'success');
                }
            });

            $('#fieldMappingForm').submit(function(e) {
                let isValid = true;
                const duplicates = [];

                $('.accordion-item').each(function() {
                    const tableColumnNames = new Set();
                    const tableName = $(this).find('.accordion-button strong').text();

                    $(this).find('input[name*="DestinationColumn"]').each(function() {
                        const value = $(this).val().trim();

                        if (value) {
                            if (tableColumnNames.has(value.toLowerCase())) {
                                duplicates.push({ table: tableName, column: value });
                                $(this).addClass('is-invalid');
                                isValid = false;
                            } else {
                                tableColumnNames.add(value.toLowerCase());
                                $(this).removeClass('is-invalid');
                            }
                        }
                    });
                });

                if (!isValid) {
                    e.preventDefault();
                    let message = 'Duplicate destination column names found:\n';
                    duplicates.forEach(d => {
                        message += `\n• Table: ${d.table}, Column: ${d.column}`;
                    });
                    alert(message);
                    showNotification('Please fix duplicate column names before proceeding', 'danger');
                    return false;
                }

                return true;
            });

            function showNotification(message, type) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px;">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                `;
                $('body').append(alertHtml);

                setTimeout(function() {
                    $('.alert').fadeOut(500, function() {
                        $(this).remove();
                    });
                }, 3000);
            }

            $('input[name*="DestinationColumn"]').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}