@model QDG_DB_Migrator.Models.RelationshipConfigViewModel
@{
    ViewData["Title"] = "Relationship Configuration";
}

<form asp-action="RelationshipConfig" method="post" id="mainConfigForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="sessionId" value="@Model.SessionId" />

    <div class="card">
        <div class="card-header">
            <h2>Table Relationships</h2>
        </div>
        <div class="card-body">
            @if (Model.HasCircularDependency)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Circular Dependency Detected!</strong>
                    <p>The tables have circular dependencies which must be resolved before migration can proceed.</p>
                </div>
            }

            <ul class="nav nav-tabs mb-3" id="relationshipTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="detected-tab" data-bs-toggle="tab" data-bs-target="#detected" type="button">
                        Detected Relationships (@Model.DetectedRelationships.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="custom-tab" data-bs-toggle="tab" data-bs-target="#custom" type="button">
                        Custom Relationships (@Model.CustomRelationships.Count)
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="columns-tab" data-bs-toggle="tab" data-bs-target="#columns" type="button">
                        Column Configuration
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="dependencies-tab" data-bs-toggle="tab" data-bs-target="#dependencies" type="button">
                        Migration Order
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="relationshipTabContent">
                <div class="tab-pane fade show active" id="detected" role="tabpanel">
                    <h4>Detected Foreign Key Relationships</h4>
                    <p class="text-muted">These relationships were automatically detected from database foreign key constraints.</p>

                    @if (Model.DetectedRelationships.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Parent Table</th>
                                        <th>Parent Column</th>
                                        <th>Child Table</th>
                                        <th>Child Column</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rel in Model.DetectedRelationships)
                                    {
                                        <tr>
                                            <td><code>@rel.ParentTable</code></td>
                                            <td><code>@rel.ParentColumn</code></td>
                                            <td><code>@rel.ChildTable</code></td>
                                            <td><code>@rel.ChildColumn</code></td>
                                            <td><span class="badge bg-primary">FK Constraint</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No foreign key relationships detected. You can add custom relationships in the next tab.
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="custom" role="tabpanel">
                    <h4>Custom Relationships</h4>
                    <p class="text-muted">Define custom relationships for tables without explicit foreign key constraints.</p>

                    <button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#addRelationshipModal">
                        <i class="bi bi-plus-circle"></i> Add Custom Relationship
                    </button>

                    @if (Model.CustomRelationships.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Parent Table</th>
                                        <th>Parent Column</th>
                                        <th>Child Table</th>
                                        <th>Child Column</th>
                                        <th>Type</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rel in Model.CustomRelationships)
                                    {
                                        <tr>
                                            <td><code>@rel.ParentTable</code></td>
                                            <td><code>@rel.ParentColumn</code></td>
                                            <td><code>@rel.ChildTable</code></td>
                                            <td><code>@rel.ChildColumn</code></td>
                                            <td><span class="badge bg-warning text-dark">Custom</span></td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-danger delete-relationship" data-id="@rel.Id">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No custom relationships defined. Click the button above to add one.
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="columns" role="tabpanel">
                    <h4>Column Configuration</h4>
                    <p class="text-muted">Configure column behavior during migration: skip copying, or drop columns entirely.</p>

                    <div class="alert alert-warning mb-3">
                        <i class="bi bi-exclamation-triangle"></i>
                        <strong>Warning:</strong> Columns marked for "Drop Column" will be permanently excluded from the destination table. This action cannot be undone during migration.
                    </div>

                    <div class="accordion" id="tableAccordion">
                        @{
                            int configIndex = 0;
                        }
                        @foreach (var table in Model.AvailableTables)
                        {
                            var columns = Model.TableColumns.ContainsKey(table) ? Model.TableColumns[table] : new List<ColumnInfo>();
                            var tableId = table.Replace(".", "_").Replace("`", "");

                            <div class="accordion-item">
                                <h2 class="accordion-header" id="heading-@tableId">
                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@tableId">
                                        <strong>@table</strong> <span class="ms-2 text-muted">(@columns.Count columns)</span>
                                    </button>
                                </h2>
                                <div id="collapse-@tableId" class="accordion-collapse collapse" data-bs-parent="#tableAccordion">
                                    <div class="accordion-body">
                                        <table class="table table-sm">
                                            <thead>
                                                <tr>
                                                    <th>Column Name</th>
                                                    <th>Data Type</th>
                                                    <th>Properties</th>
                                                    <th>Skip Copy (Auto-Inc)</th>
                                                    <th>Drop Column</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var column in columns)
                                                {
                                                    var existingConfig = Model.ColumnConfigurations.FirstOrDefault(c =>
                                                    c.TableName == table && c.ColumnName == column.ColumnName);
                                                    var skipCopy = existingConfig?.SkipCopy ?? column.IsAutoIncrement;
                                                    var dropColumn = existingConfig?.DropColumn ?? false;
                                                    var isPkOrFk = column.IsPrimaryKey || Model.DetectedRelationships
                                                    .Any(r => (r.ParentTable == table && r.ParentColumn == column.ColumnName) ||
                                                    (r.ChildTable == table && r.ChildColumn == column.ColumnName));

                                                    <tr class="@(dropColumn ? "table-danger" : "")">
                                                        <td><code>@column.ColumnName</code></td>
                                                        <td>@column.DataType</td>
                                                        <td>
                                                            @if (column.IsPrimaryKey)
                                                            {
                                                                <span class="badge bg-info">PK</span>
                                                            }
                                                            @if (column.IsAutoIncrement)
                                                            {
                                                                <span class="badge bg-success">Auto Inc</span>
                                                            }
                                                            @if (!column.IsNullable)
                                                            {
                                                                <span class="badge bg-secondary">NOT NULL</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <input type="hidden" name="columnConfigs[@configIndex].TableName" value="@table" />
                                                            <input type="hidden" name="columnConfigs[@configIndex].ColumnName" value="@column.ColumnName" />
                                                            <input type="checkbox"
                                                                   name="columnConfigs[@configIndex].SkipCopy"
                                                                   value="true"
                                                                   class="form-check-input skip-copy-checkbox"
                                                                   data-index="@configIndex"
                                                                   @(skipCopy ? "checked" : "")
                                                                   @(column.IsAutoIncrement || dropColumn ? "disabled" : "") />
                                                            @if (column.IsAutoIncrement)
                                                            {
                                                                <input type="hidden" name="columnConfigs[@configIndex].SkipCopy" value="true" />
                                                                <small class="text-muted">(Required for auto-increment)</small>
                                                            }
                                                        </td>
                                                        <td>
                                                            <input type="checkbox"
                                                                   name="columnConfigs[@configIndex].DropColumn"
                                                                   value="true"
                                                                   class="form-check-input drop-column-checkbox"
                                                                   data-index="@configIndex"
                                                                   data-is-pk-fk="@(isPkOrFk.ToString().ToLower())"
                                                                   @(dropColumn ? "checked" : "")
                                                                   @(isPkOrFk ? "disabled" : "") />
                                                            @if (isPkOrFk)
                                                            {
                                                                <small class="text-danger">(Cannot drop PK/FK)</small>
                                                            }
                                                            else if (dropColumn)
                                                            {
                                                                <small class="text-danger">(Will be dropped)</small>
                                                            }
                                                        </td>
                                                    </tr>
                                                    configIndex++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="tab-pane fade" id="dependencies" role="tabpanel">
                    <h4>Dependency Analysis & Migration Order</h4>

                    @if (!Model.HasCircularDependency && Model.MigrationOrder.Any())
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle"></i> Dependencies resolved successfully. Migration will proceed in the following order:
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <h5>Migration Order</h5>
                                <ol class="list-group list-group-numbered">
                                    @foreach (var table in Model.MigrationOrder)
                                    {
                                        <li class="list-group-item">
                                            <code>@table</code>
                                        </li>
                                    }
                                </ol>
                            </div>
                            <div class="col-md-6">
                                <h5>Dependency Graph</h5>
                                <pre class="bg-dark text-light p-3 rounded">@Model.DependencyVisualization</pre>
                            </div>
                        </div>
                    }
                    else if (Model.HasCircularDependency)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle"></i>
                            <strong>Circular Dependency Detected</strong>
                            <p>Cannot determine migration order due to circular dependencies. Please review and remove circular relationships.</p>
                        </div>
                        <pre class="bg-dark text-light p-3 rounded">@Model.DependencyVisualization</pre>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No dependencies detected. All tables are independent and can be migrated in any order.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card-footer bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="FilterConfig" asp-route-sessionId="@Model.SessionId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

                <div class="text-muted">
                    <small>Relationship Configuration</small>
                </div>

                <button type="submit" class="btn btn-success" id="submitBtn">
                    Next <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
</form>

<div class="modal fade" id="addRelationshipModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add Custom Relationship</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addRelationshipForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="sessionId" value="@Model.SessionId" />

                    <div class="mb-3">
                        <label class="form-label">Parent Table</label>
                        <select class="form-select" id="parentTable" name="parentTable" required>
                            <option value="">-- Select Parent Table --</option>
                            @foreach (var table in Model.AvailableTables)
                            {
                                <option value="@table">@table</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Parent Column</label>
                        <select class="form-select" id="parentColumn" name="parentColumn" required disabled>
                            <option value="">-- Select Parent Table First --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Child Table</label>
                        <select class="form-select" id="childTable" name="childTable" required>
                            <option value="">-- Select Child Table --</option>
                            @foreach (var table in Model.AvailableTables)
                            {
                                <option value="@table">@table</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Child Column</label>
                        <select class="form-select" id="childColumn" name="childColumn" required disabled>
                            <option value="">-- Select Child Table First --</option>
                        </select>
                    </div>

                    <div class="alert alert-info">
                        <small>This will create a dependency: <strong>Child Table</strong> depends on <strong>Parent Table</strong></small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveRelationship">Add Relationship</button>
            </div>
        </div>
    </div>
</div>

<!-- Drop Column Confirmation Modal -->
<div class="modal fade" id="dropColumnWarningModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirm Column Drop</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>You have selected columns to be dropped from the destination table.</strong></p>
                <p>The following columns will be permanently excluded:</p>
                <ul id="droppedColumnsList" class="text-danger"></ul>
                <p class="mt-3">This action cannot be undone during migration. Are you sure you want to proceed?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDrop">Yes, Drop Columns</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tableColumns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TableColumns));

        // Handle drop column checkbox changes
        $('.drop-column-checkbox').on('change', function() {
            const index = $(this).data('index');
            const isChecked = $(this).is(':checked');
            const $skipCopyCheckbox = $(`.skip-copy-checkbox[data-index="${index}"]`);
            const $row = $(this).closest('tr');

            if (isChecked) {
                // Disable skip copy when drop column is enabled
                $skipCopyCheckbox.prop('disabled', true).prop('checked', false);
                $row.addClass('table-danger');
            } else {
                // Re-enable skip copy when drop column is disabled
                $skipCopyCheckbox.prop('disabled', false);
                $row.removeClass('table-danger');
            }
        });

        // Validate before form submission
        $('#submitBtn').on('click', function(e) {
            const droppedColumns = [];

            $('.drop-column-checkbox:checked:not(:disabled)').each(function() {
                const $row = $(this).closest('tr');
                const tableName = $row.find('input[name$=".TableName"]').val();
                const columnName = $row.find('code').first().text();
                droppedColumns.push({ table: tableName, column: columnName });
            });

            if (droppedColumns.length > 0) {
                e.preventDefault();

                // Populate the modal with dropped columns
                const $list = $('#droppedColumnsList');
                $list.empty();
                droppedColumns.forEach(col => {
                    $list.append(`<li><code>${col.table}.${col.column}</code></li>`);
                });

                $('#dropColumnWarningModal').modal('show');
            }
        });

        // Confirm drop and submit form
        $('#confirmDrop').on('click', function() {
            $('#dropColumnWarningModal').modal('hide');
            $('#mainConfigForm').off('submit').submit();
        });

        $('#parentTable').on('change', function() {
            const tableName = $(this).val();
            const $parentColumn = $('#parentColumn');
            $parentColumn.empty().prop('disabled', !tableName);

            if (tableName && tableColumns[tableName]) {
                $parentColumn.append('<option value="">-- Select Column --</option>');
                tableColumns[tableName].forEach(col => {
                    const badges = [];
                    if (col.isPrimaryKey) badges.push('PK');
                    if (col.isAutoIncrement) badges.push('AI');
                    const label = badges.length ? `${col.columnName} [${badges.join(', ')}]` : col.columnName;
                    $parentColumn.append(`<option value="${col.columnName}">${label}</option>`);
                });
            }
        });

        $('#childTable').on('change', function() {
            const tableName = $(this).val();
            const $childColumn = $('#childColumn');
            $childColumn.empty().prop('disabled', !tableName);

            if (tableName && tableColumns[tableName]) {
                $childColumn.append('<option value="">-- Select Column --</option>');
                tableColumns[tableName].forEach(col => {
                    $childColumn.append(`<option value="${col.columnName}">${col.columnName}</option>`);
                });
            }
        });

        $('#saveRelationship').on('click', function() {
            const form = $('#addRelationshipForm');
            const formData = form.serialize();

            if (!$('#parentTable').val() || !$('#parentColumn').val() ||
                !$('#childTable').val() || !$('#childColumn').val()) {
                alert('Please fill in all fields');
                return;
            }

            $.ajax({
                url: '@Url.Action("AddCustomRelationship", "Migration")',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Failed to add relationship. Please try again.');
                }
            });
        });

        $('.delete-relationship').on('click', function() {
            if (!confirm('Are you sure you want to delete this relationship?')) {
                return;
            }

            const relationshipId = $(this).data('id');
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("DeleteRelationship", "Migration")',
                type: 'POST',
                data: {
                    relationshipId: relationshipId,
                    __RequestVerificationToken: token
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function() {
                    alert('Failed to delete relationship. Please try again.');
                }
            });
        });
    </script>
}