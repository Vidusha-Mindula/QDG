@model IEnumerable<DatabaseConfig>

@{
    ViewData["Title"] = "Database Configurations";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Database Configurations</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Configuration
        </a>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th>Created</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in Model)
                        {
                            <tr>
                                <td>@config.Name</td>
                                <td>@config.SourceDatabase @@ config.SourceHost</td>
                                <td>@config.DestinationDatabase @@ config.DestinationHost</td>
                                <td>@config.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (config.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        @if (!config.IsActive)
                                        {
                                            <form asp-action="SetActive" asp-route-id="@config.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success" title="Set Active">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Edit" asp-route-id="@config.Id" class="btn btn-sm btn-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@config.Id" method="post" class="d-inline" 
                                              onsubmit="return confirm('Are you sure you want to delete this configuration?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <p class="mb-0">No configurations found. Create a new configuration to get started.</p>
            </div>
        }
    </div>
</div>
