@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>QDG Database Migration Tool</h1>

<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Welcome to QDG DB Migrator</h5>
        <p class="card-text">
            A powerful tool for migrating database tables with relationships from a source database to a destination database.
        </p>
        
        <div class="mt-3">
            <h6>Features:</h6>
            <ul>
                <li>Intelligent dependency resolution</li>
                <li>Customizable field mappings</li>
                <li>Filtered data migration</li>
                <li>Real-time progress tracking</li>
                <li>Foreign key relationship management</li>
            </ul>
        </div>

        <div class="mt-4">
            <a href="/configuration" class="btn btn-primary">Get Started</a>
            <a href="/sessions" class="btn btn-secondary ms-2">View Sessions</a>
        </div>
    </div>
</div>
